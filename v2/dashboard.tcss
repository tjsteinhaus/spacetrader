/* ── Global ──────────────────────────────────────────────────────────────── */
Screen {
    background: #0d1117;
    color: #c9d1d9;
}

Header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

Footer {
    background: #161b22;
}

/* ── Shared ──────────────────────────────────────────────────────────────── */
.screen-hint {
    background: #161b22;
    color: #8b949e;
    height: 1;
    padding: 0 1;
}

.panel-title {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

.info-panel {
    border: solid #30363d;
    padding: 0 1;
    overflow-y: auto;
    height: 1fr;
}

.status-bar {
    color: #8b949e;
    height: 1;
    padding: 0 1;
}

Button {
    margin-right: 1;
}

/* ── DataTable ───────────────────────────────────────────────────────────── */
DataTable {
    height: 1fr;
}

DataTable > .datatable--header {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1f6feb40;
    color: white;
}

DataTable > .datatable--hover {
    background: #1f6feb20;
}

/* ── TabbedContent ───────────────────────────────────────────────────────── */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
    height: 1fr;
}

/* ── Dashboard ───────────────────────────────────────────────────────────── */
#dashboard-main {
    height: 1fr;
}

#dash-left {
    width: 44%;
    margin-right: 1;
}

#dash-right {
    width: 56%;
}

#agent-stats {
    height: 9;
}

#fleet-mini {
    height: 1fr;
}

#contract-panel {
    height: 10;
}

#activity-panel {
    height: 1fr;
}

#yields-panel {
    height: 5;
}

/* ── Fleet ───────────────────────────────────────────────────────────────── */
/* uses default full-screen DataTable */

/* ── Contracts ───────────────────────────────────────────────────────────── */
/* uses default full-screen DataTable */

/* ── Markets ─────────────────────────────────────────────────────────────── */
#markets-main {
    height: 1fr;
}

#market-list-panel {
    width: 30%;
    margin-right: 1;
}

#market-detail-panel {
    width: 70%;
}

#market-actions {
    height: 3;
    padding: 0 1;
    align: left middle;
}

#refresh-status {
    height: 3;
    padding: 0 1;
    content-align: left middle;
}

/* ── Universe ────────────────────────────────────────────────────────────── */
#universe-filter-bar {
    height: 3;
    padding: 0 1;
}

#universe-filter {
    width: 1fr;
}

#universe-main {
    height: 1fr;
}

#universe-list-panel {
    width: 52%;
    margin-right: 1;
}

#universe-detail-panel {
    width: 48%;
}

#universe-analysis {
    border: solid #30363d;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

/* ── Analytics ───────────────────────────────────────────────────────────── */
#txn-filters {
    height: 3;
    padding: 0 1;
    align: left middle;
}

#txn-summary {
    height: 3;
    padding: 0 1;
    content-align: left middle;
    width: 1fr;
}

#yields-filters {
    height: 3;
    padding: 0 1;
    align: left middle;
}

#income-breakdown {
    padding: 1;
    overflow-y: auto;
    height: 1fr;
}

/* ── Map ─────────────────────────────────────────────────────────────────── */
#map-main {
    height: 1fr;
}

#map-canvas {
    width: 1fr;
    height: 1fr;
    border: solid #30363d;
    overflow: hidden;
}

#map-legend-panel {
    width: 26;
    height: 1fr;
    border: solid #30363d;
    padding: 0 1;
}

#map-legend {
    height: auto;
    margin-bottom: 1;
}

#map-ships {
    height: 1fr;
    overflow-y: auto;
}

/* ── Modals ──────────────────────────────────────────────────────────────── */
ShipDetailModal, ContractDetailModal {
    align: center middle;
}

#modal-box {
    background: #161b22;
    border: solid #388bfd;
    padding: 1 2;
    width: 80%;
    height: 80%;
}

.modal-title {
    color: #58a6ff;
    text-style: bold;
    background: #0d1117;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

#close-btn {
    margin-top: 1;
    dock: bottom;
}

/* ── Settings screen ─────────────────────────────────────────────────────── */
#settings-main {
    height: 1fr;
    overflow-y: auto;
}

#auto-buy-section {
    height: auto;
    padding: 0 0 1 0;
}

#auto-buy-row {
    height: 3;
    align: left middle;
}

#cmd-ship-section {
    height: auto;
    padding: 0 0 1 0;
}

#cmd-ship-row {
    height: 3;
    align: left middle;
}

#ship-list-section {
    height: 1fr;
    min-height: 20;
}

/* Override global DataTable height only inside settings */
#targets-table {
    height: 8;
    min-height: 4;
    border: solid #30363d;
}

#edit-form {
    height: auto;
    border: solid #1f6feb;
    padding: 1 1;
    margin-top: 1;
    background: #0d1117;
}

#form-row-1 {
    height: auto;
    align: left middle;
    padding-bottom: 1;
}

#form-row-2 {
    height: 3;
    align: left middle;
}

.form-label {
    height: 1;
    content-align: left middle;
    padding: 1 0;
}

#sel-type {
    width: 28;
}

#sel-role {
    width: 18;
}

#inp-max {
    width: 10;
}

#form-msg {
    height: 1;
    content-align: left middle;
    padding: 0 1;
    color: #8b949e;
}
